{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AndexMarket",
  "version": "../package.json",
  "identifier": "com.andextech.andexmarket",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AndexTech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/andextech-logo.png": "logo.png",
      "drivers/": "drivers/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./instalador.nsh",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5ODg2ODM4RkE2RUJGRTMKUldUanYyNzZPR2lJK1Nsdjk2cUlldEFXZzFNTDRjbW5ic2REdkxpUFY1Mm1nMkREWmp3eElBSmEK",
      "endpoints": [
        "https://github.com/ginopastran/verdu-electron/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
